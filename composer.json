{
    "name": "dylan/simple-php-pdf-form-mailer",
    "description": "HTML form that renders a personal-details PDF in memory and emails it as an attachment.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "dompdf/dompdf": "^3.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "vendor-dir": "private/vendor",
        "platform": {
            "php": "8.1.0"
        }
    }
}
