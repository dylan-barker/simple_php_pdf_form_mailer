# Defence in depth: this directory is a sibling of public_html and is not
# normally reachable over HTTP. If the project is ever uploaded inside a web
# root by mistake, these rules stop the files being served.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
