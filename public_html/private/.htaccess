# Sensitive files live in public_html/private and are blocked from HTTP access
# by .htaccess. The directory sits inside the web root so the whole project can
# be uploaded to public_html/ on shared hosts. Never remove this file.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
